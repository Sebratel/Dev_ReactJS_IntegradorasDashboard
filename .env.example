# Modelo. Copie para .env e preencha — o .env NÃO é versionado.
#
# Em desenvolvimento o .env real deste projeto mora um nível ACIMA deste
# repositório (em native_matrix_Dashboard/.env), para o arquivo com as senhas
# ficar longe do que é versionado. O servidor procura em cascata e o Vite
# aponta `envDir: '../../'` por isso.
#
# Em produção (Portainer) nada disto vira arquivo: as variáveis são preenchidas
# em "Environment variables" na tela da stack.

# ---- elleven (PostgreSQL, ERP/CRM Voalle) ----
DB_ELLEVEN_HOST=
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_PORT=5432

# ---- MariaDB (Matrix, Native, massivas, quartis) ----
# A conexão abre em DB_Massives, mas cada consulta qualifica o banco na própria
# SQL. O usuário precisa de SELECT em quatro: API_WebDeveloper, DB_Massives,
# DB_Applicattion e DB_Technical_Support.
DB_MARIA_HOST=
DB_MARIA_DATABASE=DB_Massives
DB_MARIA_USER=
DB_MARIA_PASSWORD=
DB_MARIA_PORT=3306

# ---- ponte agente -> identidade (APIs externas) ----
# `atendente`/`agente` são texto livre ("Ivan Costa - Suporte Técnico"), sem
# e-mail; estas duas APIs são o que liga o nome ao cadastro.
MATRIX_API_URL=https://sebratel.matrixdobrasil.ai/rest/v1/agentes
MATRIX_API_TOKEN=
NATIVE_API_TOKEN_URL=https://sebratel.native-infinity.com.br/api/token
NATIVE_API_USERS_URL=https://sebratel.native-infinity.com.br/api/users
NATIVE_API_BEARER=
NATIVE_API_USERNAME=
NATIVE_API_PASSWORD=

# ---- servidor ----
# 8091 é a porta deste sistema (8080/8081 são do dashboard comercial).
PORT=8091

# ---------------------------------------------------------------------------
# LOGIN (Firebase Authentication)
#
# Deixar em branco faz o dashboard subir ABERTO: todo mundo entra como
# administrador, inclusive nas telas de desempenho individual (Produtividade e
# Quartis). Em produção, preencha.
#
# Crie um projeto PRÓPRIO deste sistema no console do Firebase (não reaproveite
# o de outro setor) e faça os dois passos que não aparecem em erro nenhum até o
# primeiro clique real:
#   1. Authentication -> Sign-in method -> Google -> Ativar
#   2. Authentication -> Settings -> Authorized domains -> adicionar o domínio
#      onde o dashboard roda (só localhost vem liberado)
#
# FIREBASE_PROJECT_ID (sem VITE_) é o que o SERVIDOR usa para conferir a
# assinatura do token — preencher esta liga a exigência de login.
#
# As VITE_* entram no BUNDLE em tempo de build: em produção elas são build args
# do Dockerfile, não variáveis de runtime. Trocar uma delas exige reconstruir a
# imagem. Não são segredo (vão no JavaScript do cliente por design), mas
# restrinja a chave no Google Cloud (Credenciais -> Restrições de API: só
# Identity Toolkit e Token Service).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
ALLOWED_DOMAIN=sebratel.com.br

# Quem já entra como administrador na primeira carga, antes de existir alguém
# cadastrado na tela. Aceita vários e-mails separados por vírgula, e a tela de
# Configurações não consegue rebaixar quem está aqui — é o que garante que
# sempre exista um admin capaz de abrir aquela tela.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# PROVEDOR DE IA — o botão "Insights" no cabeçalho dos gráficos.
# O caminho recomendado é cadastrar a chave em Configurações -> Provedor de IA:
# ela fica cifrada (AES-256-GCM) no volume de dados e troca sem reiniciar.
# Estas variáveis existem como semente, para o primeiro acesso.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# RECORTE DE DATAS — semente do que a tela Configurações -> Datas controla.
# padrão: a janela com que as telas abrem; máximo: o teto do que se pode pedir.
# Esticar 60->365 dias leva a tela de Quartis de ~1s a ~28s (medido).
# ---------------------------------------------------------------------------
PERIODO_PADRAO_DIAS=60
PERIODO_MAX_DIAS=365

# ---- deploy (docker-compose) ----
# Porta publicada no host. O container é sempre 8091 por dentro.
HOST_PORT=8091
