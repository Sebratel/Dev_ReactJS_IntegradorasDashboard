# dependências e artefatos de build
node_modules/
dist/
server/public/

# segredos — o .env real fica na pasta do projeto (um nível acima deste repo),
# justamente para não ficar perto do que é versionado. Use .env.example de modelo.
.env
.env.*
!.env.example

# Estado de runtime do servidor: papéis e permissões por tela (access.json), o
# recorte de datas (params.json), a configuração do provedor de IA com a chave
# cifrada (ia.json) e a CHAVE DE CIFRA em si (.secret).
#
# Nada disso é código, e o .secret é segredo de verdade: com ele, a chave de API
# gravada deixa de estar protegida. Em produção esta pasta tem de ser um volume,
# senão a configuração morre junto com o container.
server/data/

# diversos
*.log
.DS_Store
Thumbs.db
